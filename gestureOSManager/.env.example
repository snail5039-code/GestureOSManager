# 매니저 서버(8080) 환경변수 예시
#
# 전부 기본값이 있으므로 아무것도 설정하지 않아도 서버는 뜬다.
# 값을 바꾸려면 서버를 띄우는 셸에서 export 하거나 IDE 실행 구성에 넣는다.

# =========================================================
# 학습 프로필 DB 동기화 (선택, 기본 꺼짐)
# =========================================================

# true 로 켜면 학습 모델을 계정별로 DB 에 저장한다.
# 켜기 전에 테이블을 만들어야 한다:
#   psql -U sltuser -d slt -f src/main/resources/db/schema-profile.sql
# 꺼져 있으면 로컬 파일에만 저장되고, 켜져 있어도 DB 에 닿지 못하면 로컬 저장으로 내려간다.
GOS_PROFILE_DB_ENABLED=false

GOS_DB_URL=jdbc:postgresql://localhost:5432/slt
GOS_DB_USER=sltuser
GOS_DB_PASSWORD=sltpass

# =========================================================
# 폰 페어링 (QR 에 담기는 값)
# =========================================================

# 폰이 접속할 화면 스트리밍 포트 / 원격 입력 UDP 포트.
# 실제로 열리는 건 파이썬 에이전트를 --phone 으로 띄울 때뿐이다.
# GESTUREOS_PAIRING_HTTPPORT=8081
# GESTUREOS_PAIRING_UDPPORT=39500

# QR 에 표시할 PC 이름. 기본값은 COMPUTERNAME.
# GESTUREOS_PAIRING_NAME=PC

# 페어링 설정 저장 위치. 기본값: %USERPROFILE%/.gestureos/pairing.json
# GESTUREOS_PAIRING_STORAGEPATH=

# =========================================================
# AI 명령 채팅 (선택)
# =========================================================
#
# OpenAI 키는 src/main/resources/openai.yml 에 둔다(.gitignore 처리되어 있음):
#
#   openai:
#     apiKey: sk-...
#     model: gpt-5.1-mini
#
# 파일이 없으면 채팅 기능만 동작하지 않는다.
